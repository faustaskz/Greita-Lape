---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Puslapis nerastas"
  description="Ieškomas puslapis neegzistuoja arba buvo perkeltas."
  noindex={true}
>
  <div style="min-height: 70vh; display: flex; align-items: center; justify-content: center; padding: 5rem 1.5rem; background-color: #F5F0EB;">
    <div style="text-align: center; max-width: 32rem;">

      <p style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(6rem, 20vw, 12rem); font-weight: 700; color: rgba(44,26,9,0.08); line-height: 1; margin: 0;" aria-hidden="true">
        404
      </p>

      <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 700; color: #2C1A09; margin: -1rem 0 1rem;">
        Puslapis nerastas
      </h1>
      <p style="font-size: 1.0625rem; color: rgba(44,26,9,0.68); line-height: 1.75; margin: 0 0 2.5rem;">
        Galbūt URL buvo pakeistas arba puslapis ištrintas. Grįžkite į pagrindinį puslapį.
      </p>

      <a href="/" style="display: inline-block; padding: 0.875rem 2rem; background: #2C1A09; color: #fff; font-weight: 500; border-radius: 0.875rem; text-decoration: none;">
        Grįžti į pagrindinį
      </a>

    </div>
  </div>
</BaseLayout>
