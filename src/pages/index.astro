---
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../config';
---

<BaseLayout
  title="Vidaus ir išorės apdailos specialistai"
  description="MB GREITA LAPĖ – profesionalūs vidaus ir išorės apdailos darbai. Sienų glaistymas, dažymas, fasadų šiltinimas, mechanizuoti sprendimai. Greiti, tikslūs, aukštos kokybės rezultatai."
>

  <!-- ===== HERO ===== -->
  <section id="top" class="gl-hero">
    <div class="gl-hero-bg"></div>
    <div class="gl-hero-overlay"></div>

    <div class="gl-hero-content">

      <!-- Viršus: didelis pavadinimas + tagline -->
      <div class="gl-hero-top">
        <h1 class="gl-hero-title">Greita&nbsp;Lapė</h1>
        <p class="gl-hero-tagline">Vidaus ir išorės apdailos specialistai</p>
      </div>

      <!-- Apačia: apvalus CTA mygtukas dešinėje -->
      <div class="gl-hero-bottom">
        <div></div>
        <a href="#susisiekti" class="gl-hero-cta-circle">
          <span>Susisiekti</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="gl-hero-cta-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

    </div>
  </section>

  <!-- ===== APIE ===== -->
  <section id="apie" class="gl-about">
    <div class="gl-container">
      <div class="gl-about-grid">
        <h2 class="gl-about-heading">
          Apdailos ekspertai,<br />kuriais galite<br />pasitikėti
        </h2>
        <div class="gl-about-right">
          <p class="gl-about-text">
            MB GREITA LAPĖ – tai vidaus ir išorės apdailos specialistai, kurie dirba greitai, tiksliai ir itin kokybiškai. Mūsų pagrindinis tikslas – užtikrinti nepriekaištingą rezultatą, naudojant modernias technologijas, mechanizuotus darbo metodus ir aukštos kokybės medžiagas.
          </p>
          <a href="#susisiekti" class="gl-about-btn">Susisiekite su mumis</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PASLAUGOS ===== -->
  <section id="paslaugos" class="gl-services">
    <div class="gl-container">

      <div class="gl-services-intro">
        <h2 class="gl-services-heading">Mūsų paslaugos</h2>
        <div class="gl-services-intro-right">
          <p class="gl-services-desc">
            Teikiame pilną vidaus ir išorės apdailos paslaugų spektrą — nuo sienų glaistymo iki fasadų šiltinimo ir dekoratyvinių sprendimų.
          </p>
          <a href="#susisiekti" class="gl-services-link">Gauti pasiūlymą</a>
        </div>
      </div>

      <div class="gl-services-grid">

        <div class="gl-service-item">
          <!-- Pakeiskite į tikrą nuotrauką: style="background-image: url('/images/service-vidaus.jpg');" -->
          <div class="gl-service-img gl-service-img-1"></div>
          <p class="gl-service-name">Vidaus apdaila</p>
          <p class="gl-service-sub">Glaistymas, dažymas, dekoratyviniai sprendimai</p>
        </div>

        <div class="gl-service-item">
          <!-- Pakeiskite į tikrą nuotrauką: style="background-image: url('/images/service-isores.jpg');" -->
          <div class="gl-service-img gl-service-img-2"></div>
          <p class="gl-service-name">Išorės apdaila</p>
          <p class="gl-service-sub">Fasadų šiltinimas, tinkavimas, dažymas</p>
        </div>

        <div class="gl-service-item">
          <!-- Pakeiskite į tikrą nuotrauką: style="background-image: url('/images/service-gipsas.jpg');" -->
          <div class="gl-service-img gl-service-img-3"></div>
          <p class="gl-service-name">Gipso kartonas</p>
          <p class="gl-service-sub">Pertvarų, lubų ir nišų montavimas</p>
        </div>

        <div class="gl-service-item">
          <!-- Pakeiskite į tikrą nuotrauką: style="background-image: url('/images/service-mechanizuoti.jpg');" -->
          <div class="gl-service-img gl-service-img-4"></div>
          <p class="gl-service-name">Mechanizuoti sprendimai</p>
          <p class="gl-service-sub">Moderni įranga — greitis ir tikslumas</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ===== CTA SEKCIJA ===== -->
  <section class="gl-cta">
    <!-- Pakeiskite į tikrą nuotrauką: style="background-image: url('/images/cta.jpg');" -->
    <div class="gl-cta-bg"></div>
    <div class="gl-cta-overlay"></div>
    <div class="gl-cta-content">
      <h2 class="gl-cta-heading">
        Pasiruošę pradėti<br />savo projektą?
      </h2>
      <a href="#susisiekti" class="gl-cta-btn">Susisiekti</a>
    </div>
  </section>

  <!-- ===== KODĖL MES ===== -->
  <section class="gl-why">
    <div class="gl-container">
      <h2 class="gl-why-heading">Kodėl rinktis mus</h2>

      <div class="gl-why-list">

        <!-- Kortelė 01 -->
        <div class="gl-why-card">
          <div class="gl-why-text">
            <span class="gl-why-num">01</span>
            <h3 class="gl-why-title">Greitas ir efektyvus darbas</h3>
            <p class="gl-why-desc">
              Mechanizuoti darbo metodai ir moderni įranga leidžia užbaigti projektus žymiai greičiau nei tradiciniais būdais — negailinant kokybės nė lašo.
            </p>
          </div>
          <div class="gl-why-img gl-why-img-1"></div>
        </div>

        <!-- Kortelė 02 -->
        <div class="gl-why-card">
          <div class="gl-why-text">
            <span class="gl-why-num">02</span>
            <h3 class="gl-why-title">Aukšta ir pastovi kokybė</h3>
            <p class="gl-why-desc">
              Kiekvienas projektas atliekamas nepriekaištingai. Naudojame tik patikimas, ilgaamžes medžiagas, o darbų kokybė tikrinama kiekviename etape.
            </p>
          </div>
          <div class="gl-why-img gl-why-img-2"></div>
        </div>

        <!-- Kortelė 03 -->
        <div class="gl-why-card">
          <div class="gl-why-text">
            <span class="gl-why-num">03</span>
            <h3 class="gl-why-title">Ilgaamžiai ir estetiški rezultatai</h3>
            <p class="gl-why-desc">
              Mūsų meistrai turi ilgametę patirtį ir puikiai supranta, kaip sukurti ne tik gražią, bet ir ilgai išliekančią apdailą, kuria džiaugsitės daugelį metų.
            </p>
          </div>
          <div class="gl-why-img gl-why-img-3"></div>
        </div>

      </div>
    </div>
  </section>

  <!-- ===== SUSISIEKTI ===== -->
  <section id="susisiekti" class="gl-contact">
    <div class="gl-container">
      <div class="gl-contact-grid">

        <!-- Kairė: kontaktų informacija -->
        <div class="gl-contact-info">
          <h2 class="gl-contact-heading">Susisiekite</h2>

          <div class="gl-contact-details">
            <div class="gl-contact-item">
              <p class="gl-contact-label">El. paštas</p>
              <a href={`mailto:${config.companyEmail}`} class="gl-contact-value gl-contact-link">
                {config.companyEmail}
              </a>
            </div>
            <div class="gl-contact-item">
              <p class="gl-contact-label">Telefonas</p>
              <a href={`tel:${config.companyPhone.replace(/\s/g, '')}`} class="gl-contact-value gl-contact-link">
                {config.companyPhone}
              </a>
            </div>
            <div class="gl-contact-item">
              <p class="gl-contact-label">Adresas</p>
              <p class="gl-contact-value">{config.companyAddress}</p>
            </div>
            <div class="gl-contact-item">
              <p class="gl-contact-label">Darbo laikas</p>
              <p class="gl-contact-value">Pir–Pen: 8:00–18:00</p>
            </div>
          </div>
        </div>

        <!-- Dešinė: kontaktų forma -->
        <div class="gl-contact-form-wrap">
          <h3 class="gl-contact-form-title">Parašykite mums</h3>
          <form
            name="kontaktai"
            method="POST"
            action="/aciu"
            data-netlify="true"
            data-netlify-honeypot="bot-field"
            class="gl-quote-form"
          >
            <input type="hidden" name="form-name" value="kontaktai" />
            <input name="bot-field" hidden />

            <div class="gl-form-row">
              <div class="gl-form-group">
                <label class="gl-label">Vardas *</label>
                <input type="text" name="vardas" required class="gl-input" />
              </div>
              <div class="gl-form-group">
                <label class="gl-label">El. paštas *</label>
                <input type="email" name="email" required class="gl-input" />
              </div>
            </div>

            <div class="gl-form-group">
              <label class="gl-label">Telefonas</label>
              <input type="tel" name="telefonas" class="gl-input" />
            </div>

            <div class="gl-form-group">
              <label class="gl-label">Žinutė *</label>
              <textarea name="zinute" rows="5" required class="gl-input gl-textarea"></textarea>
            </div>

            <button type="submit" class="gl-contact-submit">Siųsti žinutę</button>
          </form>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Shared ─────────────────────────────────────────── */
  .gl-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  @media (min-width: 1024px) {
    .gl-container { padding: 0 2.5rem; }
  }

  /* ── HERO ────────────────────────────────────────────── */
  .gl-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  .gl-hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('/vidaus apdaila1.webp');
    background-size: cover;
    background-position: center;
  }
  .gl-hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
  }
  .gl-hero-content {
    position: relative;
    z-index: 10;
    max-width: 1280px;
    margin: 0 auto;
    padding: 9rem 1.5rem 3rem;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  @media (min-width: 1024px) {
    .gl-hero-content { padding: 10rem 2.5rem 4rem; }
  }

  .gl-hero-top { display: flex; flex-direction: column; gap: 1rem; }

  .gl-hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    color: #fff;
    line-height: 0.88;
    letter-spacing: -0.02em;
    font-size: clamp(3.5rem, 11vw, 13rem);
    margin: 0;
  }

  .gl-hero-tagline {
    color: rgba(255, 255, 255, 0.75);
    font-size: clamp(0.9rem, 1.5vw, 1.1rem);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0;
    font-weight: 400;
    padding-left: 0.4rem;
  }

  .gl-hero-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: 3rem;
  }

  /* Apvalus CTA mygtukas */
  .gl-hero-cta-circle {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 7rem;
    height: 7rem;
    border-radius: 9999px;
    border: 1px solid rgba(255,255,255,0.6);
    color: #fff;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-align: center;
    transition: background 0.3s, border-color 0.3s;
    flex-shrink: 0;
  }
  @media (min-width: 768px) {
    .gl-hero-cta-circle { width: 8.5rem; height: 8.5rem; font-size: 0.8125rem; }
  }
  .gl-hero-cta-circle:hover {
    background: rgba(255,255,255,0.15);
    border-color: #fff;
  }
  .gl-hero-cta-arrow { width: 1.25rem; height: 1.25rem; }

  /* Form styles (naudojami kontaktų sekcijoje) */
  .gl-quote-form { display: flex; flex-direction: column; gap: 1.125rem; }
  .gl-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .gl-form-group { display: flex; flex-direction: column; }
  .gl-label {
    font-size: 0.8125rem;
    color: rgba(44, 26, 9, 0.55);
    margin-bottom: 0.375rem;
  }
  .gl-input {
    border: none;
    border-bottom: 1px solid rgba(44, 26, 9, 0.25);
    padding-bottom: 0.5rem;
    color: #2C1A09;
    background: transparent;
    outline: none;
    font-size: 0.9375rem;
    transition: border-color 0.2s;
    font-family: inherit;
    width: 100%;
  }
  .gl-input:focus { border-bottom-color: #2C1A09; }
  .gl-textarea { resize: none; }

  /* ── ABOUT ───────────────────────────────────────────── */
  .gl-about {
    background-color: #2C1A09;
    color: #fff;
    padding: 6rem 0;
  }
  @media (min-width: 1024px) { .gl-about { padding: 8rem 0; } }
  .gl-about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .gl-about-grid { grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }
  }
  .gl-about-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3.75rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0;
  }
  .gl-about-text {
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.0625rem;
    line-height: 1.75;
    margin: 0 0 2rem;
  }
  .gl-about-btn {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border: 1px solid rgba(255,255,255,0.45);
    color: #fff;
    border-radius: 9999px;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .gl-about-btn:hover { background: #fff; color: #2C1A09; }

  /* ── WHY CHOOSE US ───────────────────────────────────── */
  .gl-why {
    background-color: #F5F0EB;
    padding: 6rem 0;
  }
  @media (min-width: 1024px) { .gl-why { padding: 8rem 0; } }
  .gl-why-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: #2C1A09;
    margin: 0 0 3.5rem;
  }
  .gl-why-list { display: flex; flex-direction: column; gap: 1.25rem; }
  .gl-why-card {
    background: #FDECC8;
    border-radius: 1.25rem;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 1024px) {
    .gl-why-card { grid-template-columns: 1fr 1fr; }
  }
  .gl-why-text {
    padding: 2.5rem;
  }
  @media (min-width: 1024px) { .gl-why-text { padding: 3.5rem; } }
  .gl-why-num {
    display: block;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 3.5rem;
    font-weight: 700;
    color: rgba(44, 26, 9, 0.18);
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .gl-why-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    color: #2C1A09;
    margin: 0 0 1rem;
    font-weight: 600;
  }
  .gl-why-desc {
    color: rgba(44, 26, 9, 0.68);
    font-size: 1rem;
    line-height: 1.75;
    margin: 0;
  }
  .gl-why-img {
    min-height: 260px;
    background-size: cover;
    background-position: center;
  }
  .gl-why-img-1 { background-image: url('/auksta kokybe.webp'); }
  .gl-why-img-2 { background-image: url('/stipriausi lietuvoje.webp'); }
  .gl-why-img-3 { background-image: url('/vidaus apdaila2.webp'); }

  /* ── PASLAUGOS ───────────────────────────────────────── */
  .gl-services {
    background-color: #F8F5F2;
    padding: 6rem 0;
  }
  @media (min-width: 1024px) { .gl-services { padding: 8rem 0; } }
  .gl-services-intro {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 3.5rem;
  }
  @media (min-width: 1024px) {
    .gl-services-intro { grid-template-columns: 1fr 1fr; gap: 4rem; align-items: flex-end; }
  }
  .gl-services-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: #2C1A09;
    margin: 0;
  }
  .gl-services-desc {
    color: rgba(44, 26, 9, 0.68);
    font-size: 1.0625rem;
    line-height: 1.75;
    margin: 0 0 1.5rem;
  }
  .gl-services-link {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border: 1px solid #2C1A09;
    color: #2C1A09;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .gl-services-link:hover { background: #2C1A09; color: #fff; }

  .gl-services-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (min-width: 768px) { .gl-services-grid { gap: 1.5rem; } }
  .gl-service-item { display: flex; flex-direction: column; }
  .gl-service-img {
    aspect-ratio: 4/3;
    border-radius: 0.875rem;
    overflow: hidden;
    background-size: cover;
    background-position: center;
  }
  .gl-service-img-1 { background-image: url('/vidaus apdaila3.webp'); }
  .gl-service-img-2 { background-image: url('/isores apdaila2.webp'); }
  .gl-service-img-3 { background-image: url('/gipso kartonas 1.webp'); }
  .gl-service-img-4 { background-image: url('/mechanizuota iranga.webp'); }
  .gl-service-name {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.125rem;
    color: #2C1A09;
    margin: 0.875rem 0 0.25rem;
  }
  .gl-service-sub {
    font-size: 0.8125rem;
    color: rgba(44, 26, 9, 0.55);
    margin: 0;
  }

  /* ── CTA ─────────────────────────────────────────────── */
  .gl-cta {
    position: relative;
    overflow: hidden;
  }
  .gl-cta-bg {
    position: absolute;
    inset: 0;
    /* PLACEHOLDER — pakeiskite į: background-image: url('/images/cta.jpg'); */
    background: linear-gradient(135deg, #3d2b1a 0%, #5a3d28 40%, #7a5535 100%);
    background-size: cover;
    background-position: center;
  }
  .gl-cta-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.42);
  }
  .gl-cta-content {
    position: relative;
    z-index: 10;
    max-width: 1280px;
    margin: 0 auto;
    padding: 6rem 1.5rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    align-items: flex-start;
  }
  @media (min-width: 1024px) {
    .gl-cta-content {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 7rem 2.5rem;
    }
  }
  .gl-cta-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3.75rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.15;
    margin: 0;
  }
  .gl-cta-btn {
    flex-shrink: 0;
    display: inline-block;
    padding: 1rem 2.25rem;
    background: #fff;
    color: #2C1A09;
    font-weight: 600;
    border-radius: 9999px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s;
  }
  .gl-cta-btn:hover { background: #FDECC8; }

  /* ── CONTACT ─────────────────────────────────────────── */
  .gl-contact {
    background-color: #F5F0EB;
    padding: 6rem 0;
  }
  @media (min-width: 1024px) { .gl-contact { padding: 8rem 0; } }
  .gl-contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .gl-contact-grid { grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }
  }
  .gl-contact-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    color: #2C1A09;
    margin: 0 0 2.5rem;
  }
  .gl-contact-details { display: flex; flex-direction: column; gap: 1.75rem; }
  .gl-contact-item {}
  .gl-contact-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(44, 26, 9, 0.4);
    margin: 0 0 0.375rem;
  }
  .gl-contact-value {
    font-size: 1.0625rem;
    color: rgba(44, 26, 9, 0.85);
    margin: 0;
  }
  .gl-contact-link { text-decoration: none; transition: color 0.2s; display: block; }
  .gl-contact-link:hover { color: #CC1416; }

  .gl-contact-form-wrap {
    background: #fff;
    border-radius: 1.25rem;
    padding: 2.5rem;
  }
  @media (min-width: 1024px) { .gl-contact-form-wrap { padding: 3rem; } }
  .gl-contact-form-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.625rem;
    color: #2C1A09;
    margin: 0 0 1.75rem;
  }
  .gl-contact-submit {
    margin-top: 0.5rem;
    width: 100%;
