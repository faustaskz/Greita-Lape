---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Ačiū už žinutę"
  description="Gavome jūsų žinutę ir susisieksime artimiausiu metu."
  noindex={true}
>
  <div style="min-height: 60vh; display: flex; align-items: center; justify-content: center; padding: 5rem 1.5rem; background-color: #F5F0EB;">
    <div style="text-align: center; max-width: 36rem;">

      <div style="width: 5rem; height: 5rem; border-radius: 9999px; background: #FDECC8; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
        <svg xmlns="http://www.w3.org/2000/svg" style="width: 2.5rem; height: 2.5rem; color: #2C1A09;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>

      <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; color: #2C1A09; margin: 0 0 1rem;">
        Ačiū!
      </h1>
      <p style="font-size: 1.0625rem; color: rgba(44,26,9,0.68); line-height: 1.75; margin: 0 0 2.5rem;">
        Gavome jūsų žinutę. Susisieksime su jumis artimiausiu metu ir paruošime individualų pasiūlymą.
      </p>

      <a href="/" style="display: inline-block; padding: 0.875rem 2rem; background: #2C1A09; color: #fff; font-weight: 500; border-radius: 0.875rem; text-decoration: none; transition: background 0.2s;">
        Grįžti į pagrindinį
      </a>

    </div>
  </div>
</BaseLayout>
